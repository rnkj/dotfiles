{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check_project_path.sh\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~"
      ],
      "allowRead": [
        ".",
        "~/.cache",
        "~/.claude",
        "~/.config",
        "~/.local",
        "~/.nv",
        "~/.pixi",
        "~/.uv",
        "/dev/tty*",
        "/dev/fd/*",
        "/dev/shm",
        "/dev/random",
        "/dev/urandom",
        "/dev/zero",
        "/dev/stderr",
        "/dev/stdin",
        "/dev/stdout",
        "/dev/nvidia*",
        "/dev/dri/renderD128",
        "/tmp"
      ],
      "allowWrite": [
        ".",
        "/tmp",
        "~/.cache",
        "~/.claude",
        "~/.nv",
        "~/.pixi",
        "~/.uv",
        "/dev/tty*",
        "/dev/fd/*",
        "/dev/shm",
        "/dev/null",
        "/dev/stderr",
        "/dev/stdout",
        "/dev/nvidia*",
        "/dev/dri/renderD128"
      ]
    },
    "network": {
      "allowedDomains": [
        "huggingface.co",
        "*.huggingface.co",
        "api.wandb.ai",
        "*.wandb.ai"
      ]
    }
  }
}
